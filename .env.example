# DisTributor Gateway — Environment Variables
# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit .env vào git!

# ── Adapter API Keys ─────────────────────────────────────────────────────────
# GeminiAdapter (google) — T1/T2/T3 primary
GEMINI_API_KEY=
# GroqAdapter (groq)    — T1/T2/T3 fallback 1
GROQ_API_KEY=
# OpenAIAdapter (openai) — T1/T2/T3 fallback 2
OPENAI_API_KEY=
# AnthropicAdapter (M2) — chưa implement
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Gateway Auth ──────────────────────────────────────────────────────────────
# Bearer key cho /v1/* — bỏ trống = bỏ qua auth (dev)
GATEWAY_DEV_KEY=
# X-Admin-Key for /admin/*
ADMIN_KEY=
APP_ENV=development
API_AUTH_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=
POSTGRES_PASSWORD=
# Render + Supabase: postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?sslmode=require

# ── App & Gateway Config ──────────────────────────────────────────────────────
# Lưu ý: Cấu hình Routing, Classifier & Circuit Breaker được đặt tại src/gateway/app/config/config.yaml
MAX_BODY_BYTES=1000000          # HTTP body; vượt giới hạn trả 413 request_too_large
MAX_INPUT_TOKENS=8000           # Tổng input ước lượng; vượt giới hạn trả 400 context_too_long
MAX_MESSAGES=50                 # Số messages tối đa; vượt giới hạn trả 400 too_many_messages

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8000
APP_VERSION=0.1.0
GIT_COMMIT_SHA=
BUILD_TIMESTAMP=
# Render-provided RENDER_GIT_COMMIT is used when GIT_COMMIT_SHA is unset.
CONFIG_DIR=./app/config          # chứa models.yaml, pricing.yaml, policies.yaml
LOG_LEVEL=info                   # debug | info | warning | error
LOG_CONTENT=false                # true → lưu preview prompt/response (NFR-03, privacy!)

# ── Dashboard (FE) ────────────────────────────────────────────────────────────
# Origin only: never append /admin, an API key, query parameters, or credentials.
VITE_API_URL=http://localhost:8000
VITE_API_KEY=

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
